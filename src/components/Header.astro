---
/*
 * Header — "The Specimen Registry" masthead (60px).
 *
 * Left: the registry wordmark — `oriz` in Instrument Serif italic + a
 * gold-foil EMV chip mark + `cards` in Martian Mono, sitting on an engine-turn
 * hairline. Nav: quiet mono links, phosphor-mint on hover/active. Right: an
 * `oriz.in` family link (themed), live card count, auth avatar. The filter rail
 * on home is the search — no mega-nav.
 */
import AuthButton from '~/components/AuthButton.tsx'
import MobileNavDrawer from '~/components/MobileNavDrawer.tsx'
import { TOTAL_CARD_COUNT } from '~/lib/cards'

interface Props {
  /**
   * Suppress the header's Clerk auth island. Astro islands are independent
   * React roots but clerk-react's provider guard is a page-global counter, so
   * a page may mount only ONE <ClerkProvider>. On /account the ClerkAccountPanel
   * owns that single provider — the header then shows a plain link instead.
   */
  hideAuthIsland?: boolean
}

const { hideAuthIsland = false } = Astro.props

const links = [
  { href: '/', label: 'Register' },
  { href: '/credit/', label: 'Credit' },
  { href: '/debit/', label: 'Debit' },
  { href: '/prepaid/', label: 'Prepaid' },
  { href: '/rupay/', label: 'RuPay' },
  { href: '/banks/', label: 'Banks' },
  { href: '/compare/', label: 'Compare' },
]

const current = Astro.url.pathname
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href))
const cardCount = TOTAL_CARD_COUNT.toLocaleString('en-IN')
---

<header class="hdr">
  <div class="hdr-row spine">
    <a class="wm" href="/" aria-label="oriz cards — the card registry, home">
      <span class="wm-mark">
        <span class="wm-a">oriz</span>
        <span class="wm-chip" aria-hidden="true"></span>
        <span class="wm-b">cards</span>
      </span>
    </a>

    <nav class="hdr-nav" aria-label="Primary">
      {
        links.map((item) => (
          <a href={item.href} class="nav-link" aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hdr-right">
      <a class="hdr-family" href="https://oriz.in" rel="noopener">oriz.in ↗</a>
      <span class="hdr-count mono">{cardCount} filed</span>
      <div class="auth-slot">
        {hideAuthIsland ? (
          <a class="auth-btn" href="/account/">Account</a>
        ) : (
          <AuthButton client:load />
        )}
      </div>
      <div class="mnav-slot"><MobileNavDrawer client:load links={links} current={current} /></div>
    </div>
  </div>
  <div class="hdr-guilloche guilloche-rule" aria-hidden="true"></div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--paper) 88%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }
  .hdr-row {
    display: flex;
    align-items: center;
    height: var(--nav-h, 60px);
    gap: 1.75rem;
  }
  .hdr-guilloche {
    height: 6px;
    opacity: 0.7;
  }

  /* Wordmark — Instrument Serif italic `oriz`, gold-foil chip, Martian Mono `cards`. */
  .wm {
    display: inline-flex;
    align-items: center;
    line-height: 1;
    color: var(--ink);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .wm-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }
  .wm-a {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 23px;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .wm-chip {
    width: 15px;
    height: 11px;
    border-radius: 2px;
    background:
      linear-gradient(180deg, transparent 28%, color-mix(in oklab, var(--brass-deep) 55%, transparent) 28% 33%, transparent 33% 63%, color-mix(in oklab, var(--brass-deep) 55%, transparent) 63% 68%, transparent 68%),
      linear-gradient(135deg, var(--brass-light) 0%, var(--brass) 55%, var(--brass-deep) 100%);
    border: 0.5px solid var(--brass-deep);
    box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.2);
  }
  .wm-b {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.04em;
    color: var(--ink-mute);
    text-transform: lowercase;
  }

  /* Desktop nav — quiet mono links. */
  .hdr-nav {
    display: none;
    align-items: center;
    gap: 1.35rem;
    min-width: 0;
  }
  .nav-link {
    position: relative;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--ink-mute);
    padding-block: 0.35rem;
    transition: color 0.15s ease;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.18s ease;
  }
  .nav-link:hover {
    color: var(--ink);
  }
  .nav-link[aria-current='page'] {
    color: var(--accent-deep);
  }
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
  }
  .nav-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* Right cluster — family link + count + auth. */
  .hdr-right {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }
  .hdr-family {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--accent-deep);
    padding: 0.25rem 0.5rem;
    border: 1px solid transparent;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .hdr-family:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .hdr-family:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .hdr-count {
    font-size: 12px;
    color: var(--ink-mute);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .auth-slot {
    display: none;
  }
  .mnav-slot {
    display: inline-flex;
  }

  /* Auth island — security-cyan border skin. */
  :global(.auth-btn) {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    max-width: 190px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
    cursor: pointer;
    text-decoration: none;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    padding: 0.4rem 0.85rem;
    background: var(--paper-raised);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    transition:
      border-color 0.18s ease,
      color 0.18s ease;
  }
  :global(.auth-btn:hover) {
    border-color: var(--accent);
    color: var(--accent);
  }
  :global(.auth-btn:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  :global(.auth-dot) {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink-mute);
    flex-shrink: 0;
  }
  :global(.auth-dot[data-on='true']) {
    background: var(--accent);
    box-shadow: 0 0 0 2px color-mix(in oklab, var(--accent) 35%, transparent);
  }

  /* Mobile drawer island (global — island markup is unscoped). */
  :global(.mnav-trigger) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    color: var(--ink);
    cursor: pointer;
  }
  :global(.mnav-trigger:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  :global(.mnav-bars) {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    width: 18px;
  }
  :global(.mnav-bars span) {
    display: block;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }
  :global(.mnav-bars[data-open='true'] span:nth-child(1)) {
    transform: translateY(6px) rotate(45deg);
  }
  :global(.mnav-bars[data-open='true'] span:nth-child(2)) {
    opacity: 0;
  }
  :global(.mnav-bars[data-open='true'] span:nth-child(3)) {
    transform: translateY(-6px) rotate(-45deg);
  }
  :global(.mnav-overlay) {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: color-mix(in oklab, var(--ink) 45%, transparent);
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
  }
  :global(.mnav-panel) {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 61;
    display: flex;
    flex-direction: column;
    width: min(82vw, 320px);
    height: 100dvh;
    padding: 1.5rem 1.25rem;
    background: var(--paper);
    border-left: 1px solid var(--rule);
    box-shadow: -12px 0 40px color-mix(in oklab, var(--ink) 18%, transparent);
    transform: translateX(100%);
    transition: transform 0.24s ease;
  }
  :global(.mnav-panel[data-open='true']) {
    transform: translateX(0);
  }
  :global(.mnav-links) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 2.5rem;
  }
  :global(.mnav-link) {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 21px;
    font-weight: 500;
    color: var(--ink);
    padding: 0.6rem 0.25rem;
    border-bottom: 1px solid var(--rule);
  }
  :global(.mnav-link:hover) {
    color: var(--accent);
  }
  :global(.mnav-link[aria-current='page']) {
    box-shadow: inset 3px 0 0 var(--accent);
    padding-left: 0.65rem;
  }
  :global(.mnav-link:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  :global(.mnav-foot) {
    margin-top: auto;
    padding-top: 1.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.mnav-panel),
    :global(.mnav-bars span),
    :global(.auth-btn),
    .nav-link::after {
      transition: none;
    }
    :global(.auth-btn:hover) {
      transform: none;
    }
  }

  @media (min-width: 768px) {
    .hdr-nav {
      display: inline-flex;
    }
    .auth-slot {
      display: inline-flex;
    }
    .mnav-slot {
      display: none;
    }
  }
  @media (max-width: 520px) {
    .hdr-family,
    .hdr-count {
      display: none;
    }
  }
</style>
