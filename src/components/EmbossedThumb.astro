---
/*
 * EmbossedThumb — Astro-static 140×88 embossed-card thumbnail used in
 * category/bank ledgers and the compare drawer. NO React island — these
 * render at build time as pure HTML/CSS, because the cardholder name is
 * always redacted in the thumbnail variant per the spec ("name redacted to
 * dots in list rows"). Only the hero needs a React island for the live
 * Firebase displayName.
 *
 * All component CSS lives in src/styles/global.css under .emboss-thumb-static
 * (shared with the home ledger rows, which render the same markup from the
 * CardScreener React island). This file emits markup only.
 */

interface Props {
  bankCode: string
  bankName: string
  network: string
  binPrefix?: string
  stock?: [string, string]
}

const NETWORK_LABEL: Record<string, string> = {
  Visa: 'VISA',
  Mastercard: 'MASTERCARD',
  RuPay: 'RuPay',
  Amex: 'AMEX',
  DinersClub: 'DINERS',
  Discover: 'DISCOVER',
}

const { bankCode, bankName, network, binPrefix = '4242', stock } = Astro.props as Props
const stockA = stock?.[0] ?? '#2B3A55'
const stockB = stock?.[1] ?? '#1A2438'
const networkLabel = NETWORK_LABEL[network] ?? network.toUpperCase()
const issuerLabel = (bankCode ?? bankName).toUpperCase()
const redactedName = '•••• •••• ••••'
---

<div
  class="emboss-static emboss-thumb-static"
  style={`--card-stock-a: ${stockA}; --card-stock-b: ${stockB};`}
  aria-hidden="true"
>
  <span class="emboss-issuer">{issuerLabel}</span>
  <span class="emboss-chip">
    <span class="emboss-chip-line"></span>
    <span class="emboss-chip-line"></span>
    <span class="emboss-chip-line"></span>
    <span class="emboss-chip-line"></span>
    <span class="emboss-chip-line"></span>
  </span>
  <span class="emboss-bin">{binPrefix} •••• •••• ••••</span>
  <span class="emboss-name">{redactedName}</span>
  <span class="emboss-network">{networkLabel}</span>
  <span class="emboss-shimmer"></span>
</div>
