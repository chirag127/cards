---
import EmbossedCard from '~/components/EmbossedCard.tsx'
import EmbossedThumb from '~/components/EmbossedThumb.astro'
/*
 * Canonical card detail — the prospectus. Static SSG, one page per card id
 * (all 750). Path: /cards/{id}/.
 *
 * Layout:
 *   [breadcrumb]
 *   [hero: large embossed card + name/tagline + 4-stat strip + apply CTA]
 *   [benefits grid]
 *   [spec sections: eligibility, fees, ATM, transactions, fuel, limits,
 *    insurance, rewards, lounge — two-column rows]
 *   [similar cards]
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import {
  type FullCard,
  fmtApr,
  fmtPct,
  getAllCards,
  getCardById,
  getSimilarRows,
  inr,
} from '~/lib/cards'
import { SITE_CONFIG } from '~/lib/siteConfig'

export function getStaticPaths() {
  return getAllCards().map((c) => ({ params: { id: c.id } }))
}

const { id } = Astro.params as { id: string }
const card = getCardById(id) as FullCard | undefined

if (!card) {
  return Astro.redirect('/')
}

const charges = card.charges ?? []
const find = (label: string) =>
  charges.find((c) => c.label?.toLowerCase().includes(label.toLowerCase()))
const joining = find('Joining')
const annual = find('Annual')
const aprMonthly = card.transactionCharges?.interestRatePerMonth
const aprAnnual = card.transactionCharges?.annualInterestRate ?? (aprMonthly ?? 0) * 12
const rwLabel = card.rewardProgram?.rewardRateStr ?? card.rewardProgram?.earnRate ?? '—'
const rwRatePct = card.rewardProgram?.effectiveCashbackPercent ?? null

const ATM = card.atmCharges ?? {}
const TX = card.transactionCharges ?? {}
const FUEL = card.fuelSurcharge
const LIMITS = card.limits ?? {}
const INS = card.insurance
const RW = card.rewardProgram
const LOUNGE = card.loungeAccess

const NETWORK_STOCK: Record<string, [string, string]> = {
  Visa: ['#2B3A55', '#1A2438'],
  Mastercard: ['#3D2A20', '#1F140C'],
  RuPay: ['#1F4A33', '#0F2A1D'],
  Amex: ['#2A2F5C', '#101535'],
  DinersClub: ['#1F1F1F', '#000000'],
  Discover: ['#5C3A1F', '#2A1A0E'],
}
const network = String(card.network ?? 'Visa')
const stockA = card.gradientColors?.[0] ?? NETWORK_STOCK[network]?.[0] ?? '#2B3A55'
const stockB = card.gradientColors?.[1] ?? NETWORK_STOCK[network]?.[1] ?? '#1A2438'
const binPrefix =
  (card.bin ?? '').toString().slice(0, 4) ||
  ({ Visa: '4242', Mastercard: '5333', RuPay: '6076', Amex: '3742', DinersClub: '3600' }[network] ??
    '4242')

interface Row {
  label: string
  value: string
  note?: string
  isNeg?: boolean
}

const eligibilityRows: Row[] = [
  { label: 'Employment', value: card.eligibility?.employmentType?.join(' / ') ?? '—' },
  {
    label: 'Min annual income',
    value: card.eligibility?.minAnnualIncome ? `₹${inr(card.eligibility.minAnnualIncome)}` : '—',
  },
  {
    label: 'Min monthly salary',
    value: card.eligibility?.minSalary ? `₹${inr(card.eligibility.minSalary)}` : '—',
  },
  { label: 'Age', value: `${card.eligibility?.minAge ?? '—'} – ${card.eligibility?.maxAge ?? '—'}` },
  {
    label: 'Min credit score',
    value: card.eligibility?.minCreditScore ? String(card.eligibility.minCreditScore) : '—',
  },
  {
    label: 'Existing account?',
    value: card.eligibility?.existingAccountRequired ? 'Required' : 'Not required',
  },
  { label: 'Invitation only?', value: card.eligibility?.invitationOnly ? 'Yes' : 'No' },
]

const feeRows: Row[] = [
  {
    label: 'Joining fee',
    value: joining?.amount === 0 ? 'Lifetime free' : `₹${inr(joining?.amount)}`,
    note:
      joining?.note ??
      (joining?.amountWithGst ? `+ GST → ₹${inr(joining.amountWithGst)}` : undefined),
  },
  {
    label: 'Annual fee',
    value: annual?.amount === 0 ? 'Lifetime free' : `₹${inr(annual?.amount)}`,
    note:
      annual?.note ?? (annual?.amountWithGst ? `+ GST → ₹${inr(annual.amountWithGst)}` : undefined),
  },
  { label: 'APR (monthly)', value: aprMonthly ? `${fmtPct(aprMonthly, '%')} p.m.` : '—' },
  { label: 'APR (annual)', value: fmtApr(aprAnnual) },
  {
    label: 'Late payment fee',
    value: TX.latePaymentFee ? `₹${inr(TX.latePaymentFee)}` : '—',
    note: 'per cycle, charged to statement',
    isNeg: !!TX.latePaymentFee,
  },
  {
    label: 'Over-limit fee',
    value: TX.overLimitFee ? `₹${inr(TX.overLimitFee)}` : '—',
    isNeg: !!TX.overLimitFee,
  },
  {
    label: 'Cheque bounce',
    value: TX.chequeBounceCharge ? `₹${inr(TX.chequeBounceCharge)}` : '—',
    isNeg: !!TX.chequeBounceCharge,
  },
  {
    label: 'Grace period',
    value: card.creditCardDetails?.gracePeriodDays
      ? `${card.creditCardDetails.gracePeriodDays} days`
      : '—',
  },
  {
    label: 'Min due',
    value: card.creditCardDetails?.minimumDuePercent
      ? `${card.creditCardDetails.minimumDuePercent}%`
      : '—',
    note: card.creditCardDetails?.minimumDueFlat
      ? `or ₹${inr(card.creditCardDetails.minimumDueFlat)}, whichever higher`
      : undefined,
  },
]

const atmRows: Row[] = [
  {
    label: 'Own bank free / month',
    value: ATM.ownBankFreePerMonth !== undefined ? String(ATM.ownBankFreePerMonth) : '—',
  },
  { label: 'Own bank charge', value: ATM.ownBankCharge ? `₹${inr(ATM.ownBankCharge)}` : '—' },
  {
    label: 'Other bank free / month',
    value: ATM.otherBankFreePerMonth !== undefined ? String(ATM.otherBankFreePerMonth) : '—',
  },
  { label: 'Other bank charge', value: ATM.otherBankCharge ? `₹${inr(ATM.otherBankCharge)}` : '—' },
  {
    label: 'International withdrawal',
    value: ATM.internationalWithdrawalFee ? `₹${inr(ATM.internationalWithdrawalFee)}` : '—',
    note: ATM.internationalWithdrawalPercent
      ? `+ ${ATM.internationalWithdrawalPercent}% of txn`
      : undefined,
  },
  {
    label: 'Cash advance fee',
    value: TX.cashAdvanceFeePercent ? `${TX.cashAdvanceFeePercent}%` : '—',
    note: TX.cashAdvanceFlatFee ? `min ₹${inr(TX.cashAdvanceFlatFee)}` : undefined,
  },
]

const txRows: Row[] = [
  { label: 'Currency markup', value: TX.currencyMarkupPercent ? `${TX.currencyMarkupPercent}%` : '—' },
  { label: 'DCC fee', value: TX.dccFeePercent ? `${TX.dccFeePercent}%` : '—' },
  { label: 'Cross-border fee', value: TX.crossBorderFee ? `₹${inr(TX.crossBorderFee)}` : '—' },
  { label: 'SMS alert / month', value: TX.smsAlertPerMonth ? `₹${inr(TX.smsAlertPerMonth)}` : '—' },
  { label: 'PIN regen', value: TX.pinRegenerationCharge ? `₹${inr(TX.pinRegenerationCharge)}` : '—' },
  {
    label: 'Physical statement',
    value: TX.physicalStatementCharge ? `₹${inr(TX.physicalStatementCharge)}` : '—',
  },
]

const fuelRows: Row[] = FUEL?.available
  ? [
      { label: 'Surcharge waiver', value: FUEL.waiverPercent ? `${FUEL.waiverPercent}%` : '—' },
      { label: 'Min txn', value: FUEL.minTransactionAmount ? `₹${inr(FUEL.minTransactionAmount)}` : '—' },
      { label: 'Max txn', value: FUEL.maxTransactionAmount ? `₹${inr(FUEL.maxTransactionAmount)}` : '—' },
      {
        label: 'Max waiver / cycle',
        value: FUEL.maxWaiverPerCycle ? `₹${inr(FUEL.maxWaiverPerCycle)}` : '—',
      },
      { label: 'Networks', value: FUEL.fuelNetworks?.length ? FUEL.fuelNetworks.join(', ') : 'All' },
    ]
  : [{ label: 'Fuel waiver', value: 'Not available' }]

const limitRows: Row[] = [
  { label: 'ATM / day', value: LIMITS.atmPerDay ? `₹${inr(LIMITS.atmPerDay)}` : '—' },
  { label: 'POS + e-com / day', value: LIMITS.posEcomPerDay ? `₹${inr(LIMITS.posEcomPerDay)}` : '—' },
  {
    label: 'Contactless / txn',
    value: LIMITS.contactlessPerTxn ? `₹${inr(LIMITS.contactlessPerTxn)}` : '—',
  },
  {
    label: 'Contactless / day',
    value: LIMITS.contactlessDailyLimit ? `₹${inr(LIMITS.contactlessDailyLimit)}` : '—',
  },
]

const insRows: Row[] = INS
  ? [
      {
        label: 'Accidental death cover',
        value: INS.accidentalDeathCover ? `₹${inr(INS.accidentalDeathCover)}` : '—',
      },
      {
        label: 'Permanent disability',
        value: INS.permanentDisabilityCover ? `₹${inr(INS.permanentDisabilityCover)}` : '—',
      },
      { label: 'Air accident', value: INS.airAccidentCover ? `₹${inr(INS.airAccidentCover)}` : '—' },
      {
        label: 'Travel insurance',
        value: INS.travelInsuranceCover ? `₹${inr(INS.travelInsuranceCover)}` : '—',
      },
      { label: 'Baggage', value: INS.baggageCover ? `₹${inr(INS.baggageCover)}` : '—' },
      {
        label: 'Lost-card liability',
        value: INS.lostCardLiability ? `₹${inr(INS.lostCardLiability)}` : '—',
        note: INS.lostCardLiabilityWindow ? `within ${INS.lostCardLiabilityWindow} h of loss` : undefined,
      },
      {
        label: 'Purchase protection',
        value: INS.purchaseProtectionCover ? `₹${inr(INS.purchaseProtectionCover)}` : '—',
        note: INS.purchaseProtectionDays ? `${INS.purchaseProtectionDays} days` : undefined,
      },
    ]
  : [{ label: 'Insurance', value: 'Not provided' }]

const rwRows: Row[] = RW
  ? [
      { label: 'Programme', value: RW.name ?? '—' },
      { label: 'Earn rate', value: RW.earnRate ?? '—' },
      { label: 'Point value', value: RW.pointValue ? `₹${RW.pointValue}` : '—' },
      { label: 'Effective cashback', value: rwRatePct !== null ? fmtPct(rwRatePct, '%') : '—' },
      {
        label: 'Min redemption',
        value: RW.minRedemptionPoints ? `${inr(RW.minRedemptionPoints)} pts` : '—',
      },
      { label: 'Expiry', value: RW.pointsExpiry ?? '—' },
    ]
  : [{ label: 'Rewards programme', value: 'Not available' }]

const loungeRows: Row[] = LOUNGE
  ? [
      {
        label: 'Domestic',
        value: LOUNGE.domestic
          ? (LOUNGE.domestic.frequency ?? `${LOUNGE.domestic.count ?? 0} visits / yr`)
          : '—',
        note: LOUNGE.domestic?.valuePerVisit
          ? `value ₹${inr(LOUNGE.domestic.valuePerVisit)} per visit`
          : undefined,
      },
      {
        label: 'International',
        value: LOUNGE.international
          ? (LOUNGE.international.frequency ?? `${LOUNGE.international.count ?? 0} visits / yr`)
          : '—',
        note: LOUNGE.international?.valuePerVisit
          ? `value ₹${inr(LOUNGE.international.valuePerVisit)} per visit`
          : undefined,
      },
      { label: 'Domestic guests allowed?', value: LOUNGE.domestic?.guestAllowed ? 'Yes' : 'No' },
      {
        label: 'International guests allowed?',
        value: LOUNGE.international?.guestAllowed ? 'Yes' : 'No',
      },
    ]
  : [{ label: 'Lounge access', value: 'Not available' }]

const sections: Array<{ key: string; title: string; rows: Row[] }> = [
  { key: 'eligibility', title: 'ELIGIBILITY', rows: eligibilityRows },
  { key: 'fees', title: 'FEES', rows: feeRows },
  { key: 'atm', title: 'ATM & CASH', rows: atmRows },
  { key: 'tx', title: 'TRANSACTIONS', rows: txRows },
  { key: 'fuel', title: 'FUEL', rows: fuelRows },
  { key: 'limits', title: 'LIMITS', rows: limitRows },
  { key: 'insurance', title: 'INSURANCE', rows: insRows },
  { key: 'rewards', title: 'REWARDS', rows: rwRows },
  { key: 'lounge', title: 'LOUNGE', rows: loungeRows },
]

const benefits = (card.benefits ?? []).filter((b) => b.title)
const similar = getSimilarRows(card, 6)
const typeLabel = card.cardType
const description =
  card.tagline ??
  card.description ??
  `${card.name} by ${card.bank} — fees, rewards, eligibility, and every charge on one page.`

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: card.name,
  brand: { '@type': 'Brand', name: card.bank },
  category: `${network} ${typeLabel} card`,
  description,
  url: `${SITE_CONFIG.origin}/cards/${card.id}/`,
}
---

<BaseLayout
  title={`${card.name} — fees, rewards, eligibility · oriz · cards`}
  description={description}
  jsonLd={jsonLd}
>
  <article class="detail">
    <header class="detail-head spine">
      <p class="detail-eyebrow mono">
        <a href="/">cards</a> / <a href={`/${typeLabel}/`}>{typeLabel}</a> /
        <a href={`/banks/${card.bankCode}/`}>{card.bank.toLowerCase()}</a> / {card.slug}
      </p>
      <div class="detail-hero">
        <div class="detail-hero-card">
          <EmbossedCard
            client:load
            size="hero"
            cardName={card.name}
            bankCode={card.bankCode}
            bankName={card.bank}
            network={network}
            stock={[stockA, stockB]}
            binPrefix={binPrefix}
            redactName={false}
          />
          <p class="detail-hero-emboss-note mono">
            ↑ Your name appears embossed when you <a href="/account/">sign in</a>.
          </p>
        </div>
        <div class="detail-hero-meta">
          <h1 class="detail-h1">{card.name}</h1>
          <p class="detail-tag">{description}</p>
          <dl class="stat-strip">
            <div class="stat">
              <dt class="stat-l mono">JOIN</dt>
              <dd class="stat-v num">
                {joining?.amount === 0 ? <span class="ltf-tag">LTF</span> : `₹${inr(joining?.amount)}`}
              </dd>
            </div>
            <div class="stat">
              <dt class="stat-l mono">ANNUAL</dt>
              <dd class="stat-v num">
                {annual?.amount === 0 ? <span class="ltf-tag">LTF</span> : `₹${inr(annual?.amount)}`}
              </dd>
            </div>
            <div class="stat">
              <dt class="stat-l mono">REWARDS</dt>
              <dd class="stat-v num">{rwLabel}</dd>
            </div>
            <div class="stat">
              <dt class="stat-l mono">APR</dt>
              <dd class={`stat-v num ${aprAnnual >= 36 ? 'num-neg' : ''}`}>{fmtApr(aprAnnual)}</dd>
            </div>
          </dl>
          <div class="detail-meta mono">
            <span>{network.toUpperCase()}</span>
            <span aria-hidden="true">·</span>
            <span>{typeLabel.toUpperCase()}</span>
            <span aria-hidden="true">·</span>
            <span>{card.tier ?? card.cardType}</span>
            <span aria-hidden="true">·</span>
            <span>{card.material ?? 'Plastic'}</span>
            {card.virtualCardAvailable && (
              <>
                <span aria-hidden="true">·</span>
                <span>VIRTUAL OK</span>
              </>
            )}
          </div>
          {card.applyUrl ? (
            <a href={card.applyUrl} rel="noopener noreferrer" target="_blank" class="apply-cta">
              [ APPLY ON {card.bank.toUpperCase()} → ]
            </a>
          ) : (
            <p class="apply-cta apply-cta-disabled mono">[ APPLY URL NOT PUBLISHED ]</p>
          )}
        </div>
      </div>
    </header>

    {benefits.length > 0 && (
      <section class="benefits spine">
        <h2 class="section-h mono">§ BENEFITS</h2>
        <div class="benefit-grid">
          {benefits.map((b) => (
            <div class="benefit-card">
              {b.category && <span class="benefit-cat mono">{b.category}</span>}
              <h3 class="benefit-title">{b.title}</h3>
              {b.description && <p class="benefit-desc">{b.description}</p>}
              {(b.valueStr || b.annualValue) && (
                <p class="benefit-val num mono">
                  {b.valueStr ?? (b.annualValue ? `≈ ₹${inr(b.annualValue)} / yr` : '')}
                </p>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="spec-table spine">
      {
        sections.map((s) => (
          <div class="spec-section" id={s.key}>
            <h2 class="spec-h mono">§ {s.title}</h2>
            <dl class="spec-rows">
              {s.rows.map((r) => (
                <div class="spec-row">
                  <dt class="spec-l">{r.label}</dt>
                  <dd class={`spec-v num ${r.isNeg ? 'num-neg' : ''}`}>{r.value}</dd>
                  {r.note && <p class="spec-note">† {r.note}</p>}
                </div>
              ))}
            </dl>
          </div>
        ))
      }
    </section>

    {similar.length > 0 && (
      <section class="similar spine">
        <h2 class="section-h mono">§ SIMILAR CARDS</h2>
        <div class="similar-grid">
          {similar.map((r) => (
            <a href={`/cards/${r.id}/`} class="similar-card">
              <EmbossedThumb
                bankCode={r.bankCode}
                bankName={r.bank}
                network={r.network}
                binPrefix={r.binPrefix}
                stock={r.stockGradient}
              />
              <span class="similar-meta">
                <span class="similar-name">{r.name}</span>
                <span class="similar-bank mono">{r.bank} · {r.network}</span>
                <span class="similar-fee mono">
                  ANNUAL {r.annualFee === 0 ? 'LTF' : `₹${inr(r.annualFee)}`}
                </span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="apply-band spine">
      <p class="apply-disc">
        Information here is for reference. Always verify on the issuing bank's site before applying.
        oriz · cards is not affiliated with {card.bank} and earns no commission on applications.
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .detail { display: flex; flex-direction: column; }
  .detail-head {
    padding-block: 2rem 1.75rem;
    border-bottom: 1px solid var(--rule);
  }
  .detail-eyebrow {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-mute);
    margin: 0 0 1.5rem;
  }
  .detail-eyebrow a { color: var(--ink-mute); }
  .detail-eyebrow a:hover { color: var(--accent); }

  .detail-hero {
    display: grid;
    grid-template-columns: 480px minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
  }
  @media (max-width: 1023px) {
    .detail-hero { grid-template-columns: 1fr; gap: 1.5rem; }
  }
  .detail-hero-card { display: flex; flex-direction: column; gap: 0.75rem; align-items: flex-start; }
  .detail-hero-emboss-note {
    margin: 0;
    color: var(--ink-mute);
    font-size: 11px;
    letter-spacing: 0.04em;
  }
  .detail-hero-emboss-note a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

  .detail-hero-meta { display: flex; flex-direction: column; gap: 1rem; }
  .detail-h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.75rem, 3.4vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--ink);
  }
  .detail-tag { margin: 0; color: var(--ink-mute); font-size: 0.9375rem; line-height: 1.55; max-width: 56ch; }
  .stat-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    padding: 0.875rem 0;
    margin: 0.75rem 0 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .stat { display: flex; flex-direction: column; gap: 0.25rem; padding-inline: 0.75rem; border-right: 1px solid var(--rule); }
  .stat:first-child { padding-left: 0; }
  .stat:last-child { border-right: 0; padding-right: 0; }
  .stat-l { font-size: 10px; letter-spacing: 0.16em; color: var(--ink-mute); text-transform: uppercase; }
  .stat-v { margin: 0; font-family: var(--font-mono); font-size: 18px; font-weight: 500; color: var(--ink); }
  .num-neg { color: var(--vermilion); }
  .ltf-tag {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    background: linear-gradient(135deg, var(--brass-light) 0%, var(--brass) 60%, var(--brass-deep) 100%);
    color: #1a1410;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .detail-meta {
    display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem;
    color: var(--ink-mute); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
  }

  .section-h {
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--accent);
    text-transform: uppercase;
    margin: 0 0 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--rule);
  }

  /* ── Benefits grid ─────────────────────────────────────────────── */
  .benefits { padding-block: 2.5rem 0.5rem; }
  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }
  .benefit-card {
    display: flex; flex-direction: column; gap: 0.4rem;
    padding: 1rem;
    border: 1px solid var(--rule);
    background: var(--paper-raised);
  }
  .benefit-cat {
    font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent);
  }
  .benefit-title { margin: 0; font-size: 0.9375rem; font-weight: 600; color: var(--ink); line-height: 1.3; }
  .benefit-desc { margin: 0; font-size: 13px; color: var(--ink-mute); line-height: 1.5; }
  .benefit-val { margin: 0.25rem 0 0; font-size: 12px; color: var(--ink); font-family: var(--font-mono); }

  /* ── Spec table ─────────────────────────────────────────────────── */
  .spec-table {
    padding-block: 2.5rem 1rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 3rem;
  }
  @media (max-width: 768px) { .spec-table { grid-template-columns: 1fr; } }
  .spec-section { display: flex; flex-direction: column; gap: 0.75rem; }
  .spec-h {
    font-size: 11px; letter-spacing: 0.18em; color: var(--accent); text-transform: uppercase;
    margin: 0; padding-bottom: 0.5rem; border-bottom: 1px solid var(--rule);
  }
  .spec-rows { display: flex; flex-direction: column; gap: 0.6rem; margin: 0; }
  .spec-row {
    display: grid; grid-template-columns: 1fr auto; column-gap: 1.5rem; align-items: baseline;
    padding-block: 0.4rem; border-bottom: 1px dotted var(--rule);
  }
  .spec-l { font-size: 13px; color: var(--ink); margin: 0; }
  .spec-v {
