---
import CardScreener from '~/components/CardScreener.tsx'
/*
 * Home — the dense full-width card screener. Left filter rail (~260px) + a
 * dense auto-fill grid of compact TEXT card tiles filling ALL remaining
 * viewport width. NO max-width container, NO card images, NO marketing hero.
 *
 * Filters + results are ONE React island (CardScreener, client:load) so
 * selecting a filter narrows the grid instantly. Rows serialise inline as a
 * compact CardRow[] so the island runs without a fetch (all 750 cards).
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import {
  getAllRows,
  listCardTypes,
  listIssuers,
  listNetworks,
  MAX_ANNUAL_FEE,
  TOTAL_CARD_COUNT,
} from '~/lib/cards'
import { SITE_CONFIG } from '~/lib/siteConfig'

const rows = getAllRows()
const issuers = listIssuers()
const networks = listNetworks()
const cardTypes = listCardTypes()

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'oriz · cards',
  url: SITE_CONFIG.origin,
  description: SITE_CONFIG.description,
  isPartOf: { '@type': 'WebSite', name: 'oriz', url: 'https://oriz.in' },
  publisher: { '@type': 'Person', name: 'Chirag Singhal', url: 'https://oriz.in/about/' },
}
---

<BaseLayout jsonLd={jsonLd}>
  <CardScreener
    client:load
    rows={rows}
    issuers={issuers}
    networks={networks}
    cardTypes={cardTypes}
    maxFee={MAX_ANNUAL_FEE}
    total={TOTAL_CARD_COUNT}
  />
</BaseLayout>

<style is:global>
  /* ══════════════════════════════════════════════════════════════════════
     Dense full-width screener. White bg, near-black ink, one indigo accent,
     light borders, green LTF pill. Inter, small type, tight line-height.
     Breaks out of the chrome's centered column to go edge-to-edge.
     ══════════════════════════════════════════════════════════════════════ */
  :root {
    --scr-bg: #ffffff;
    --scr-ink: #1a1a1f;
    --scr-mute: #6b6b76;
    --scr-border: #ececf1;
    --scr-accent: #635bff;
    --scr-accent-soft: #efeeff;
    --scr-ltf: #0f9d58;
    --scr-ltf-soft: #e6f6ec;
    --scr-rail-w: 260px;
    --scr-font: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  /* Break out of the chrome's flex/centered main so the shell spans the full
     viewport width — no max-width, no auto side margins. */
  #main .scr-shell {
    display: grid;
    grid-template-columns: var(--scr-rail-w) minmax(0, 1fr);
    gap: 0;
    width: 100%;
    min-height: calc(100vh - 56px);
    background: var(--scr-bg);
    color: var(--scr-ink);
    font-family: var(--scr-font);
    font-size: 13px;
    line-height: 1.3;
    border-top: 1px solid var(--scr-border);
  }

  /* ── Filter rail ────────────────────────────────────────────────────── */
  .scr-rail {
    border-right: 1px solid var(--scr-border);
    background: var(--scr-bg);
  }
  .scr-rail-inner {
    position: sticky;
    top: 56px;
    max-height: calc(100vh - 56px);
    overflow-y: auto;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .scr-rail-summary {
    display: flex;
    align-items: baseline;
    gap: 5px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--scr-border);
  }
  .scr-count {
    font-size: 22px;
    font-weight: 700;
    color: var(--scr-ink);
    font-variant-numeric: tabular-nums;
  }
  .scr-total {
    font-size: 11px;
    color: var(--scr-mute);
  }
  .scr-search {
    width: 100%;
    height: 34px;
    padding-inline: 10px;
    background: var(--scr-bg);
    border: 1px solid var(--scr-border);
    border-radius: 7px;
    color: var(--scr-ink);
    font: inherit;
    font-size: 13px;
  }
  .scr-search:focus-visible {
    outline: 2px solid var(--scr-accent);
    outline-offset: 1px;
    border-color: var(--scr-accent);
  }
  .scr-search::placeholder {
    color: var(--scr-mute);
  }
  .scr-sect {
    margin: 0;
    padding: 0;
    border: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .scr-h {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--scr-mute);
    margin: 0 0 3px;
    padding: 0;
  }
  .scr-check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--scr-ink);
    cursor: pointer;
    line-height: 1.2;
  }
  .scr-check input {
    accent-color: var(--scr-accent);
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin: 0;
  }
  .scr-check-n {
    margin-left: auto;
    color: var(--scr-mute);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }
  .scr-bank-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .scr-banks {
    display: flex;
    flex-direction: column;
    gap: 5px;
    max-height: 220px;
    overflow-y: auto;
    padding: 6px 4px 6px 0;
    border-top: 1px solid var(--scr-border);
    border-bottom: 1px solid var(--scr-border);
  }
  .scr-range {
    width: 100%;
    accent-color: var(--scr-accent);
    cursor: pointer;
  }
  .scr-range-ends {
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    color: var(--scr-mute);
    margin-top: 2px;
  }
  .scr-reset {
    margin-top: 4px;
    padding: 8px;
    background: transparent;
    border: 1px solid var(--scr-border);
    border-radius: 7px;
    color: var(--scr-mute);
    font: inherit;
    font-size: 12px;
    cursor: pointer;
    transition: color 120ms, border-color 120ms;
  }
  .scr-reset:hover {
    border-color: var(--scr-accent);
    color: var(--scr-accent);
  }

  /* ── Main results area ──────────────────────────────────────────────── */
  .scr-main {
    display: flex;
    flex-direction: column;
    padding: 12px;
    min-width: 0;
  }
  .scr-toolbar {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 40px;
    margin-bottom: 10px;
    border-bottom: 1px solid var(--scr-border);
  }
  .scr-filter-btn {
    display: none;
    padding: 6px 12px;
    background: var(--scr-bg);
    border: 1px solid var(--scr-border);
    border-radius: 7px;
    color: var(--scr-ink);
    font: inherit;
    font-size: 12px;
    cursor: pointer;
  }
  .scr-toolbar-count {
    font-size: 12px;
    color: var(--scr-mute);
    font-variant-numeric: tabular-nums;
  }
  .scr-sort {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }
  .scr-sort-lbl {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--scr-mute);
  }
  .scr-select {
    height: 30px;
    padding-inline: 8px;
    background: var(--scr-bg);
    border: 1px solid var(--scr-border);
    border-radius: 7px;
    color: var(--scr-ink);
    font: inherit;
    font-size: 12px;
    cursor: pointer;
  }
  .scr-select:focus-visible {
    outline: 2px solid var(--scr-accent);
    outline-offset: 1px;
    border-color: var(--scr-accent);
  }

  /* ── Dense text-tile grid ───────────────────────────────────────────── */
  .scr-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 8px;
  }
  .tile {
    position: relative;
    display: block;
    padding: 10px;
    background: var(--scr-bg);
    border: 1px solid var(--scr-border);
    border-radius: 8px;
    color: var(--scr-ink);
    text-decoration: none;
    transition: border-color 120ms, background 120ms;
  }
  .tile:hover {
    border-color: var(--scr-accent);
    background: var(--scr-accent-soft);
  }
  .tile:focus-visible {
    outline: 2px solid var(--scr-accent);
    outline-offset: 1px;
  }
  .tile-top {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .tile-name {
    flex: 1 1 auto;
    min-width: 0;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding-right: 18px;
  }
  .tile-fee {
    flex-shrink: 0;
    font-size: 12px;
    font-weight: 600;
    color: var(--scr-ink);
    font-variant-numeric: tabular-nums;
  }
  .tile-fee.is-ltf {
    padding: 1px 6px;
    border-radius: 999px;
    background: var(--scr-ltf-soft);
    color: var(--scr-ltf);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .tile-meta {
    margin-top: 3px;
    font-size: 11px;
    color: var(--scr-mute);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tile-perks {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
    margin-top: 6px;
    min-height: 16px;
  }
  .tile-perk {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    font-size: 10px;
    line-height: 1;
    border: 1px solid var(--scr-border);
    border-radius: 5px;
    color: var(--scr-mute);
  }
  .tile-cmp {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: var(--scr-bg);
    border: 1px solid var(--scr-border);
    border-radius: 5px;
    color: var(--scr-mute);
    font: inherit;
    font-size: 13px;
    line-height: 1;
    cursor: pointer;
    transition: color 120ms, border-color 120ms, background 120ms;
  }
  .tile-cmp:hover:not(:disabled) {
    border-color: var(--scr-accent);
    color: var(--scr-accent);
  }
  .tile-cmp.on {
    background: var(--scr-accent);
    border-color: var(--scr-accent);
    color: #fff;
  }
  .tile-cmp:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .scr-empty {
    padding: 4rem 1rem;
    text-align: center;
    color: var(--scr-mute);
    font-size: 13px;
  }
  .scr-empty button {
    background: transparent;
    border: 0;
    color: var(--scr-accent);
    text-decoration: underline;
    cursor: pointer;
    font: inherit;
  }

  /* ── Pagination ─────────────────────────────────────────────────────── */
  .scr-pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--scr-border);
  }
  .scr-pager-btn {
    padding: 6px 12px;
    background: var(--scr-bg);
    border: 1px solid var(--scr-border);
    border-radius: 7px;
    color: var(--scr-ink);
    font: inherit;
    font-size: 12px;
    cursor: pointer;
    transition: color 120ms, border-color 120ms;
  }
  .scr-pager-btn:hover:not(:disabled) {
    border-color: var(--scr-accent);
    color: var(--scr-accent);
  }
  .scr-pager-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .scr-pager-status {
    font-size: 11px;
    color: var(--scr-mute);
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  /* ── Mobile: rail collapses to a slide-down sheet ───────────────────── */
  @media (max-width: 860px) {
    #main .scr-shell {
      grid-template-columns: 1fr;
    }
    .scr-rail {
      border-right: 0;
      border-bottom: 1px solid var(--scr-border);
      max-height: 0;
      overflow: hidden;
      transition: max-height 200ms ease;
    }
    .scr-rail.open {
      max-height: 80vh;
    }
    .scr-rail-inner {
      position: static;
      max-height: none;
    }
    .scr-filter-btn {
      display: inline-block;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scr-rail,
    .tile,
    .tile-cmp {
      transition: none !important;
    }
  }
</style>
