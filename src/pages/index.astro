---
import CardScreener from '~/components/CardScreener.tsx'
/*
 * Home — the ORIZ·CARDS v2 slate terminal ledger. Left filter rail (320px) +
 * a fluid LEDGER of 64px rows filling the remaining viewport width. NO hero,
 * NO marketing grid — every card is a row in a database, every fee a number
 * in a column.
 *
 * Filters + results are ONE React island (CardScreener, client:load) so
 * selecting a filter narrows the ledger instantly. Rows serialise inline as
 * a compact CardRow[] so the island runs without a fetch (all 1,300 cards).
 *
 * All screener/ledger styles live in src/styles/global.css (v2 slate system).
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import {
  getAllRows,
  listCardTypes,
  listIssuers,
  listNetworks,
  MAX_ANNUAL_FEE,
  TOTAL_CARD_COUNT,
} from '~/lib/cards'
import { SITE_CONFIG } from '~/lib/siteConfig'

const rows = getAllRows()
const issuers = listIssuers()
const networks = listNetworks()
const cardTypes = listCardTypes()

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'oriz · cards',
  url: SITE_CONFIG.origin,
  description: SITE_CONFIG.description,
  isPartOf: { '@type': 'WebSite', name: 'oriz', url: 'https://oriz.in' },
  publisher: { '@type': 'Person', name: 'Chirag Singhal', url: 'https://oriz.in/about/' },
}
---

<BaseLayout jsonLd={jsonLd} hideSidebar={true}>
  <CardScreener
    client:load
    rows={rows}
    issuers={issuers}
    networks={networks}
    cardTypes={cardTypes}
    maxFee={MAX_ANNUAL_FEE}
    total={TOTAL_CARD_COUNT}
  />
</BaseLayout>
