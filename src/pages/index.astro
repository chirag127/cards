---
import CardScreener from '~/components/CardScreener.tsx'
import EmbossedThumb from '~/components/EmbossedThumb.astro'
/*
 * Home — the ledger. Bloomberg-terminal card screener: 320px sticky filter
 * rail on the left, scrollable card-row table on the right, compare drawer
 * pinned bottom-right. All interaction (search, filters, sort, pagination,
 * compare) lives in the CardScreener React island (client:load).
 *
 * NO marketing hero. NO card grid. NO star ratings. Every card is a row in a
 * database, every fee is a number in a column. The display contract — Geist
 * Mono headings, Inter Tight body, JetBrains Mono numerics — is the
 * Bloomberg-terminal metaphor made concrete.
 *
 * We render all 750 cards (credit + debit + prepaid); the card-type filter
 * defaults to all. Rows serialise inline as a compact CardRow[] so the island
 * runs without a fetch.
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import {
  getAllRows,
  listCardTypes,
  listIssuers,
  listNetworks,
  MAX_ANNUAL_FEE,
  TOTAL_CARD_COUNT,
} from '~/lib/cards'
import { SITE_CONFIG } from '~/lib/siteConfig'

const rows = getAllRows()
const issuers = listIssuers()
const networks = listNetworks()
const cardTypes = listCardTypes()

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'oriz · cards',
  url: SITE_CONFIG.origin,
  description: SITE_CONFIG.description,
  isPartOf: { '@type': 'WebSite', name: 'oriz', url: 'https://oriz.in' },
  publisher: { '@type': 'Person', name: 'Chirag Singhal', url: 'https://oriz.in/about/' },
}
---

<BaseLayout jsonLd={jsonLd}>
  {/* Hidden thumb: pulls the shared .emboss-thumb-static global CSS into the
      bundle so the island's React-rendered thumbnails are styled. */}
  <div hidden aria-hidden="true">
    <EmbossedThumb bankCode="visa" bankName="VISA" network="Visa" />
  </div>

  <CardScreener
    client:load
    rows={rows}
    issuers={issuers}
    networks={networks}
    cardTypes={cardTypes}
    maxFee={MAX_ANNUAL_FEE}
    total={TOTAL_CARD_COUNT}
  />
</BaseLayout>

<style is:global>
  /* ── Layout shell ───────────────────────────────────────────────────── */
  .ledger-shell {
    display: grid;
    grid-template-columns: var(--rail-width, 320px) minmax(0, 1fr);
    gap: 0;
    min-height: calc(100vh - 56px);
    border-top: 1px solid var(--rule);
  }
  @media (max-width: 1024px) {
    .ledger-shell {
      grid-template-columns: 1fr;
    }
  }

  /* ── Filter rail ────────────────────────────────────────────────────── */
  .rail {
    border-right: 1px solid var(--rule);
    background: var(--paper-deep);
  }
  .rail-inner {
    position: sticky;
    top: 56px;
    max-height: calc(100vh - 56px);
    overflow-y: auto;
    padding: 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .rail-summary {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    padding-bottom: 0.875rem;
    border-bottom: 1px solid var(--rule);
  }
  .rail-count {
    font-size: 28px;
    font-weight: 700;
    color: var(--ink);
    font-feature-settings: 'tnum' 1, 'zero' 1, 'calt' 0;
  }
  .rail-total {
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--ink-mute);
  }

  /* ── Search ─────────────────────────────────────────────────────────── */
  .rail-search-input {
    width: 100%;
    height: 34px;
    padding-inline: 0.6rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .rail-search-input:focus {
    outline: none;
    border-color: var(--accent);
  }
  .rail-search-input::placeholder {
    color: var(--ink-mute);
  }

  .rail-section {
    margin: 0;
    padding: 0;
    border: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .rail-h {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-mute);
    margin: 0 0 0.4rem;
    padding: 0;
  }
  .rail-select {
    width: 100%;
    height: 32px;
    padding-inline: 0.5rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .rail-select:focus {
    outline: none;
    border-color: var(--accent);
  }
  .rail-checks {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .rail-check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 13px;
    color: var(--ink);
    cursor: pointer;
  }
  .rail-check input {
    accent-color: var(--accent);
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .issuer-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .issuer-count {
    margin-left: auto;
    color: var(--ink-mute);
    font-size: 11px;
  }
  .rail-issuers-scroll {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    max-height: 220px;
    overflow-y: auto;
    padding-right: 0.25rem;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding-block: 0.5rem;
  }

  /* ── Fee range slider ───────────────────────────────────────────────── */
  .rail-range {
    width: 100%;
    accent-color: var(--accent);
  }
  .rail-range-ends {
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    color: var(--ink-mute);
    margin-top: 0.125rem;
  }

  .rail-reset {
    margin-top: 0.5rem;
    padding: 0.5rem;
    background: transparent;
    border: 1px dashed var(--rule);
    color: var(--ink-mute);
    font-size: 11px;
    letter-spacing: 0.08em;
    cursor: pointer;
  }
  .rail-reset:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* ── Ledger ─────────────────────────────────────────────────────────── */
  .ledger {
    display: flex;
    flex-direction: column;
    background: var(--paper);
  }
  .ledger-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 44px;
    padding-inline: 1rem;
    border-bottom: 1px solid var(--rule);
    background: var(--paper-deep);
    position: sticky;
    top: 56px;
    z-index: 11;
  }
  .sort-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .sort-select {
    width: auto;
    height: 28px;
  }
  .toolbar-count {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .ledger-header {
    display: grid;
    grid-template-columns: 156px minmax(200px, 1fr) 132px 128px 100px 116px 36px;
    align-items: center;
    height: 40px;
    padding-inline: 1rem;
    border-bottom: 1px solid var(--rule);
    background: var(--paper-raised);
    position: sticky;
    top: 100px;
    z-index: 10;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .ledger-header > span {
    padding-inline: 0.5rem;
  }
  .ledger-body {
    display: flex;
    flex-direction: column;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 36px;
    align-items: stretch;
    border-bottom: 1px solid var(--rule);
  }
  .row:hover {
    background: var(--paper-raised);
  }
  .row-link {
    display: grid;
    grid-template-columns: 156px minmax(200px, 1fr) 132px 128px 100px 116px;
    align-items: center;
    height: 96px;
    padding-left: 1rem;
    color: var(--ink);
    text-decoration: none;
  }
  .row-link > * {
    padding-inline: 0.5rem;
  }
  .row-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .col-thumb {
    display: flex;
    justify-content: flex-start;
    align-items: center;
  }
  .col-name {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  .row-name {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 14px;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .row-bank {
    font-size: 11px;
    color: var(--ink-mute);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  /* ── Badges ─────────────────────────────────────────────────────────── */
  .col-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    align-items: center;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.4rem;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    border: 1px solid var(--rule);
    color: var(--ink-mute);
    text-transform: uppercase;
  }
  .badge-net {
    color: var(--ink);
  }
  .badge-credit {
    border-color: color-mix(in oklab, var(--accent) 50%, var(--rule));
    color: var(--accent);
  }
  .badge-debit {
    border-color: color-mix(in oklab, var(--brass, #b8923a) 60%, var(--rule));
    color: var(--brass, #b8923a);
  }
  .badge-prepaid {
    border-color: color-mix(in oklab, var(--vermilion, #c2410c) 40%, var(--rule));
    color: var(--vermilion, #c2410c);
  }

  /* ── Benefit icons + tooltips ───────────────────────────────────────── */
  .col-perks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    align-items: center;
  }
  .perk-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    font-size: 12px;
    border: 1px solid var(--rule);
    background: var(--paper);
    cursor: help;
    line-height: 1;
  }
  .perk-icon:hover {
    border-color: var(--accent);
  }

  .col-num {
    text-align: right;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink);
    font-feature-settings: 'tnum' 1, 'zero' 1, 'calt' 0;
  }
  .num-neg {
    color: var(--vermilion, #c2410c);
  }
  .ltf-tag {
    display: inline-block;
    padding: 0.125rem 0.375rem;
    background: linear-gradient(135deg, var(--brass-light, #ecd28a) 0%, var(--brass, #b8923a) 60%, var(--brass-deep, #8b6e2a) 100%);
    color: #1a1410;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .col-cmp {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .cmp-check {
    width: 18px;
    height: 18px;
    accent-color: var(--accent);
  }

  /* ── Pagination ─────────────────────────────────────────────────────── */
  .pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem;
    border-top: 1px solid var(--rule);
    background: var(--paper-deep);
  }
  .pager-btn {
    padding: 0.4rem 0.75rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    cursor: pointer;
  }
  .pager-btn:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }
  .pager-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .pager-status {
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ink-mute);
    text-align: center;
  }

  .ledger-empty {
    padding: 4rem 1rem;
    text-align: center;
    color: var(--ink-mute);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .ledger-empty button {
    background: transparent;
    border: 0;
    color: var(--accent);
    text-decoration: underline;
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
  }

  @media (max-width: 1024px) {
    .rail {
      border-right: 0;
      border-bottom: 1px solid var(--rule);
    }
    .rail-inner {
      position: static;
      max-height: none;
    }
    .ledger-header {
      grid-template-columns: 120px minmax(140px, 1fr) 96px 90px 36px;
    }
    .ledger-header .col-badges,
    .ledger-header span:nth-child(6) {
      display: none;
    }
    .row-link {
      grid-template-columns: 120px minmax(140px, 1fr) 96px 90px;
    }
    .row-link .col-badges,
    .row-link .col-num:last-child {
      display: none;
    }
  }

  /* ── Compare drawer ─────────────────────────────────────────────────── */
  .cmp-drawer {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 40;
    width: 320px;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
  }
  .cmp-toggle {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    padding: 0.625rem 0.875rem;
    background: var(--paper-deep);
    border: 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .cmp-toggle-icon {
    color: var(--ink-mute);
    transition: transform 120ms;
  }
  .cmp-drawer.open .cmp-toggle-icon {
    transform: rotate(180deg);
  }
  .cmp-body {
    padding: 0.875rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .cmp-empty {
    margin: 0;
    color: var(--ink-mute);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .cmp-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .cmp-item {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    column-gap: 0.5rem;
    align-items: center;
    padding: 0.4rem 0.5rem;
    background: var(--paper);
    border: 1px solid var(--rule);
  }
  .cmp-item-name {
    font-size: 12px;
    color: var(--ink);
    font-family: var(--font-sans);
    grid-column: 1;
  }
  .cmp-item-bank {
    grid-column: 1;
    grid-row: 2;
    font-size: 10px;
    color: var(--ink-mute);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .cmp-item-x {
    grid-column: 2;
    grid-row: 1 / 3;
    width: 28px;
    height: 28px;
    background: transparent;
    border: 1px solid var(--rule);
    color: var(--ink-mute);
    cursor: pointer;
    font-size: 14px;
  }
  .cmp-item-x:hover {
    border-color: var(--vermilion, #c2410c);
    color: var(--vermilion, #c2410c);
  }
  .cmp-go {
    appearance: none;
    display: block;
    text-align: center;
    text-decoration: none;
    background: var(--paper);
    border: 1px solid var(--accent);
    color: var(--accent);
    padding: 0.5rem;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.12em;
    cursor: pointer;
  }
  .cmp-go:hover:not(.cmp-go-disabled) {
    background: var(--accent);
    color: var(--accent-fg, #fff);
  }
  .cmp-go-disabled {
    opacity: 0.4;
    pointer-events: none;
    cursor: not-allowed;
  }
  @media (max-width: 480px) {
    .cmp-drawer {
      width: calc(100vw - 2rem);
    }
  }
</style>
