---
/*
 * Per-bank / issuer page — one page per unique bankCode. Lists every card
 * that issuer offers, broken out by type, with a quick stat header.
 */
import CardLedgerList from '~/components/CardLedgerList.astro'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { type CardRow, getRowsByBank, inr, listIssuers } from '~/lib/cards'
import { SITE_CONFIG } from '~/lib/siteConfig'

export function getStaticPaths() {
  return listIssuers().map((i) => ({ params: { bank: i.code }, props: { name: i.name } }))
}

const { bank } = Astro.params as { bank: string }
const { name } = Astro.props as { name: string }
const rows = getRowsByBank(bank)

if (rows.length === 0) {
  return Astro.redirect('/')
}

const byType: Array<{ key: string; title: string; rows: CardRow[] }> = [
  { key: 'credit', title: 'CREDIT', rows: rows.filter((r) => r.cardType === 'credit') },
  { key: 'debit', title: 'DEBIT', rows: rows.filter((r) => r.cardType === 'debit') },
  { key: 'prepaid', title: 'PREPAID', rows: rows.filter((r) => r.cardType === 'prepaid') },
].filter((g) => g.rows.length > 0)

const ltf = rows.filter((r) => r.annualFee === 0).length
const lounge = rows.filter((r) => r.hasLounge).length
const title = `${name} cards — credit, debit & prepaid fees · oriz · cards`
const description = `All ${rows.length} cards issued by ${name} — joining fee, annual fee, APR, rewards and eligibility side by side.`

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${name} cards`,
  url: `${SITE_CONFIG.origin}/banks/${bank}/`,
  description,
  about: { '@type': 'BankOrCreditUnion', name },
  isPartOf: { '@type': 'WebSite', name: 'oriz · cards', url: SITE_CONFIG.origin },
}
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="cat spine">
    <p class="cat-eyebrow mono"><a href="/">cards</a> / <a href="/banks/">banks</a> / {bank}</p>
    <h1 class="cat-h1">{name}</h1>
    <p class="cat-tag">{description}</p>
    <dl class="cat-stats">
      <div><dt class="mono">TOTAL</dt><dd class="num">{inr(rows.length, { keepZero: true })}</dd></div>
      <div><dt class="mono">LIFETIME FREE</dt><dd class="num">{inr(ltf, { keepZero: true })}</dd></div>
      <div><dt class="mono">WITH LOUNGE</dt><dd class="num">{inr(lounge, { keepZero: true })}</dd></div>
    </dl>
  </section>

  {
    byType.map((g) => (
      <section class="cat-list spine">
        <h2 class="section-h mono">§ {g.title} · {g.rows.length}</h2>
        <CardLedgerList rows={g.rows} />
      </section>
    ))
  }
</BaseLayout>

<style>
  .cat { padding-block: 2rem 1.5rem; border-bottom: 1px solid var(--rule); }
  .cat-eyebrow { font-size: 11px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--ink-mute); margin: 0 0 1rem; }
  .cat-eyebrow a { color: var(--ink-mute); }
  .cat-eyebrow a:hover { color: var(--accent); }
  .cat-h1 { font-family: var(--font-display); font-weight: 900; font-size: clamp(1.75rem, 3.4vw, 2.5rem); margin: 0; color: var(--ink); }
  .cat-tag { margin: 0.5rem 0 1.25rem; color: var(--ink-mute); font-size: 0.9375rem; line-height: 1.55; max-width: 64ch; }
  .cat-stats { display: flex; gap: 0; margin: 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding: 0.75rem 0; }
  .cat-stats > div { padding-inline: 1rem; border-right: 1px solid var(--rule); }
  .cat-stats > div:first-child { padding-left: 0; }
  .cat-stats > div:last-child { border-right: 0; }
  .cat-stats dt { font-size: 10px; letter-spacing: 0.14em; color: var(--ink-mute); text-transform: uppercase; margin: 0 0 0.25rem; }
  .cat-stats dd { margin: 0; font-family: var(--font-mono); font-size: 20px; font-weight: 500; color: var(--ink); }

  .section-h {
    font-size: 11px; letter-spacing: 0.18em; color: var(--accent); text-transform: uppercase;
    margin: 0 0 1.25rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--rule);
  }
  .cat-list { padding-block: 1.75rem 1rem; }
  .cat-list:last-of-type { padding-bottom: 4rem; }
</style>
