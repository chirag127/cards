---
import '@chirag127/astro-shell/tokens.css'
import '~/styles/global.css'
import '~/styles/tokens.css'
import '~/styles/oriz-ui-overrides.css'
import BottomBar from '@chirag127/astro-chrome/BottomBar.astro'
import Footer from '@chirag127/astro-chrome/Footer.astro'
import Sidebar from '@chirag127/astro-chrome/Sidebar.astro'
import AppSidebarContent from '~/components/AppSidebarContent.astro'
import CompareDrawer from '~/components/CompareDrawer.tsx'
import Header from '~/components/Header.astro'
import { bottomBarActions } from '~/data/bottombar-actions'
import { listIssuers, TOTAL_CARD_COUNT } from '~/lib/cards'
import { SITE_CONFIG } from '~/lib/siteConfig'

interface Props {
  title?: string
  description?: string
  canonical?: string
  noindex?: boolean
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  /** Hide the site chrome — use for full-bleed layouts (the home ledger needs the chrome). */
  hideChrome?: boolean
  /** Hide the left chrome sidebar only (home screener is full-width, has its own filter rail). */
  hideSidebar?: boolean
}

const {
  title = `oriz · cards — ${SITE_CONFIG.tagline}`,
  description = SITE_CONFIG.description,
  canonical = `${SITE_CONFIG.origin}${Astro.url.pathname}`,
  noindex = false,
  jsonLd,
  hideChrome = false,
  hideSidebar = false,
} = Astro.props

const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN
const cardCount = TOTAL_CARD_COUNT.toLocaleString('en-IN')
const issuerCount = String(listIssuers().length)
const footerCols = [
  {
    label: 'Catalog',
    items: [
      { name: 'All cards', url: '/' },
      { name: 'Credit', url: '/credit/' },
      { name: 'Debit', url: '/debit/' },
      { name: 'Prepaid', url: '/prepaid/' },
      { name: 'RuPay', url: '/rupay/' },
      { name: 'Banks', url: '/banks/' },
      { name: 'Compare', url: '/compare/' },
    ],
  },
  {
    label: 'Methodology',
    items: [
      { name: 'About', url: '/about/' },
      { name: 'Contact', url: '/contact/' },
      { name: 'Account', url: '/account/' },
    ],
  },
  {
    label: 'Data',
    items: [
      { name: 'cards.json', url: '/cards.json' },
      { name: 'compare-data.json', url: '/compare-data.json' },
    ],
  },
  {
    label: 'Legal',
    items: [
      { name: 'Privacy', url: '/legal/privacy/' },
      { name: 'Terms', url: '/legal/terms/' },
      { name: 'Cookies', url: '/legal/cookies/' },
      { name: 'Disclaimer', url: '/legal/disclaimer/' },
      { name: 'Grievance', url: '/legal/grievance/' },
    ],
  },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="oriz / cards" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@chirag127" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Archivo:wght@400;500;600;700&family=Martian+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    {jsonLd && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(Array.isArray(jsonLd) ? jsonLd : [jsonLd])}
      />
    )}

    {beaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${beaconToken}"}`}
      />
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    {hideChrome ? (
      <main id="main"><slot /></main>
    ) : (
      <>
        <Header />
        <div class={`layout-body${hideSidebar ? '' : ' has-sidebar'}`}>
          {!hideSidebar && (
            <Sidebar><AppSidebarContent /></Sidebar>
          )}
          <main id="main" class="layout-main"><slot /></main>
        </div>
        <Footer
          columns={footerCols}
          showNewsletter={false}
          showSupport={false}
        >
          <p class="ftr-stub mono">LAST REFRESHED 2026-08-01 · {cardCount} CARDS · {issuerCount} ISSUERS · SOURCE: ISSUER WEBSITES</p>
          <p class="ftr-stub mono">© oriz 2026</p>
        </Footer>
        <BottomBar actions={bottomBarActions} />
        <CompareDrawer client:load />
      </>
    )}
    <style>
      .layout-body { display: block; }
      .layout-main { min-height: 50vh; }
      .layout-body.has-sidebar { display: flex; align-items: flex-start; }
      .layout-body.has-sidebar .layout-main { flex: 1 1 auto; min-width: 0; }
      @media (max-width: 767px) {
        .layout-body.has-sidebar { display: block; }
        .layout-main { padding-bottom: 64px; }
      }
    </style>
  </body>
</html>
